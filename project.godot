; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="BeyondTheEye"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Fx="*res://scripts/fx.gd"
Sfx="*res://scripts/sfx.gd"
Net="*res://scripts/net.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="dunya"
3d_physics/layer_2="oyuncu"
3d_physics/layer_3="zombiler"
3d_physics/layer_4="parcalar"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_etc2_astc=true
rendering_device/fallback_to_opengl3=true

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=2
